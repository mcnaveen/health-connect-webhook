# Copy this file to .env (not committed) and generate a different 32+ character random value.
GATEWAY_API_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARACTERS

# Raw personal health records are NOT stored unless explicitly enabled.
# To opt in, change 0 to 1 and rebuild/recreate the container.
GATEWAY_ENABLE_RECORD_STORE=0
